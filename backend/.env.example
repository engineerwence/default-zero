SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
JWT_SECRET=change-this-to-a-random-string
GROQ_API_KEY=your-groq-api-key
AFRICASTALKING_API_KEY=your-key
AFRICASTALKING_USERNAME=your-username
MPESA_CONSUMER_KEY=your-key
MPESA_CONSUMER_SECRET=your-secret
MPESA_SHORTCODE=your-paybill-or-till-number
MPESA_PASSKEY=your-daraja-passkey
MPESA_CALLBACK_URL=https://default-zero-api.onrender.com/finance/mpesa/callback
MPESA_ENV=sandbox

# Long random string — protects the /notifications/send and /notifications/nudge-stale-containers
# routes from being called by anyone except your own scheduled job. Generate one with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=python -c "import secrets; print(secrets.token_hex(32))"

# Comma-separated, no spaces. Your Expo dev URL AND your production frontend URL both need to be here.
ALLOWED_ORIGINS=https://defaultzero.app,exp://192.168.1.5:8081
