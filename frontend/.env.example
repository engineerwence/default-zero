EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# IMPORTANT: never use localhost here — your phone is a different device and can't reach
# your laptop's localhost. Use your deployed Render URL once step 6 below is done, e.g.:
# EXPO_PUBLIC_API_URL=https://default-zero-api.onrender.com
EXPO_PUBLIC_API_URL=https://default-zero-api.onrender.com
